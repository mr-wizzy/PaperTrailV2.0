      {
        "id": "ls-kf-1",
        "severity": "High",
        "title": "Cold-Chain Temperature Excursion During Transport",
        "description": "Two shipments of monoclonal cocktail investigational product experienced a 4-hour excursion above -20C during transit between Lagos depot and Owo site.",
        "recommendation": "Quarantine affected product vials, conduct accelerated stability testing, and transition to validated temperature-logging dry ice shippers."
      },
      {
        "id": "ls-kf-2",
        "severity": "Medium",
        "title": "EDC Data Entry Latency Across Rural Satellite Clinics",
        "description": "Median time to adverse event electronic CRF entry exceeded the 48-hour protocol threshold by 36 hours at Irrua facility due to connectivity outages.",
        "recommendation": "Implement offline-capable tablet sync workflows for trial coordinators and equip central research room with redundant cellular hotspots."
      }
    ],
